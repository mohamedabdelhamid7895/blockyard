# Copy to .env (or set these on your host). Everything is optional for local development.

# Postgres connection string. Leave empty locally to use the embedded database in .data/.
# Free options: Neon (neon.tech) or Supabase. Required in production unless you mount a persistent disk.
DATABASE_URL=

# Encrypts stored Anthropic API keys. Required in production; use a long random string and never change it.
APP_SECRET=

# Public URL of the server, used in links (e.g. https://blockyard.onrender.com).
PUBLIC_URL=http://localhost:8787

# Optional wildcard domain for published sites: <site>.SITES_DOMAIN (needs a *.domain DNS record pointing here).
SITES_DOMAIN=

# Hostname custom domains should CNAME to. Defaults to <site>.SITES_DOMAIN or the PUBLIC_URL host.
CNAME_TARGET=

# Other sites allowed to call the API, comma-separated (e.g. the GitHub Pages copy of the editor).
CORS_ORIGINS=

PORT=8787
